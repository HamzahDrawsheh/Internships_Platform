# Backend — copy to .env and fill in values

PORT=3001
DATABASE_PATH=./database.db

# Supabase JWT / JWKS configuration
# Example JWKS URL: https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_AUDIENCE=authenticated

# Allowed CORS origin for the frontend
CORS_ORIGIN=http://localhost:3000

NODE_ENV=development